{
  "testCommand": "dotnet test Backend.Tests --logger:trx && node --test --test-reporter=tap test/**/*.test.js",
  "reporter": "exitcode",
  "testGlobs": [
    "test/**/*.test.js",
    "Backend.Tests/**/*.cs",
    "Frontend/src/**/*.spec.ts",
    "Frontend/src/**/*.test.ts"
  ],
  "srcGlobs": [
    "Backend/**/*.cs",
    "Frontend/src/**/*.ts",
    "Frontend/src/**/*.html",
    "Frontend/src/**/*.scss"
  ],
  "ignoreGlobs": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".spec/**",
    "Backend/obj/**",
    "Frontend/.angular/**"
  ]
}
